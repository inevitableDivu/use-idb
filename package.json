{
  "name": "@inevitable_divu/use-idb",
  "version": "1.0.0",
  "description": "Zero-dependency, high-performance IndexedDB reactive state engine for React 19 & TypeScript. Features microtask write coalescing, AES-GCM (NIST AAD) encryption, cross-tab synchronization, and full Suspense support.",
  "keywords": [
    "indexeddb",
    "react",
    "react-19",
    "offline-first",
    "local-first",
    "state-management",
    "storage",
    "cache",
    "crypto",
    "aes-gcm",
    "zero-dependency",
    "typescript",
    "hooks",
    "suspense",
    "broadcast-channel",
    "concurrent-react"
  ],
  "author": "Divyansh Pandey <pandeydivyansh070501@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inevitableDivu/use-idb.git"
  },
  "homepage": "https://github.com/inevitableDivu/use-idb#readme",
  "bugs": {
    "url": "https://github.com/inevitableDivu/use-idb/issues"
  },
  "license": "MIT",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "require": "./dist/core/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@testing-library/react": "^16.2.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^26.0.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2004",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
